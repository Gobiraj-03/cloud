# ==============================================================================
# AssetFlow Root — Docker Ignore File
# Prevents sensitive credentials, frontend builds, local sqlite data, and repo files from image
# ==============================================================================

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
frontend/

# Local Environment Variables & Secrets
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Local SQLite Databases & Backups
data/
backups/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Test Suites & Coverage
tests/
backend/tests/
frontend/src/test/
coverage/
.nyc_output/

# Logs & Temporary Files
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Documentation & Diagrams
docs/
*.md

# Git & Editor Files
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db
