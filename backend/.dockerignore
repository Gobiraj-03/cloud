# ==============================================================================
# AssetFlow Backend — Docker Ignore File
# Prevents sensitive credentials, local data, tests, and build artifacts from leaking into images
# ==============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables & Secrets (CRITICAL: Never bake secrets into image)
.env
.env.*
*.env
!.env.example

# Local SQLite Databases & Backups (CRITICAL: Never copy local SQLite DB to image)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/
backups/

# Test Suites & Mock Artifacts
tests/
coverage/
.nyc_output/

# Logs & Temporary Files
logs/
*.log

# Git & Repository Metadata
.git/
.gitignore
.gitattributes

# Editor & OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Documentation & Markdown
*.md
docs/

# Docker Files
Dockerfile
.dockerignore
docker-compose*.yml
