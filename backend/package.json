{
  "name": "asset-management-backend",
  "version": "1.0.0",
  "description": "Backend API for Cloud-Based IT Asset Lifecycle and Software License Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "asset-management",
    "license-management",
    "express",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
