# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (PLACEHOLDERS ONLY - NO REAL SECRETS)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Path to SQLite database file (local file storage, excluded from Git)
DB_PATH=../data/asset_management.db

# Client CORS Configuration (Single Origin for SPA cookie credentials)
CORS_ORIGIN=http://localhost:5173

# Administrator Provisioning Placeholders (Optional - used during initial setup)
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@enterprise.local
# ADMIN_INITIAL_PASSWORD=ReplaceWithStrongPassword123!
# ADMIN_NAME=Enterprise IT Administrator
